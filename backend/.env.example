# Copy to .env and fill in real values. Never commit .env.

# --- Flask ---
FLASK_ENV=development
SECRET_KEY=change-me-in-production

# --- Auth (JWT) ---
JWT_SECRET=change-me-too
JWT_EXPIRES_MINUTES=1440

# --- Database ---
# SQLite file lives at the project root by default.
DATABASE_URL=sqlite:///ai_home_manager.db

# --- LLM via OpenRouter ---
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini

# --- RAG / Vector store ---
CHROMA_PERSIST_DIR=./chroma_store
EMBEDDING_MODEL=text-embedding-3-small

# --- Document Storage ---
CLOUDINARY_CLOUD_NAME=replace-with-your-cloud-name
CLOUDINARY_API_KEY=replace-with-your-api-key
CLOUDINARY_API_SECRET=replace-with-your-api-secret
CLOUDINARY_FOLDER=ai-home-manager/backend/documents
# Choose cloudinary or local. Local files remain private under LOCAL_DOCUMENT_STORAGE_DIR.
DOCUMENT_STORAGE_PROVIDER=cloudinary
LOCAL_DOCUMENT_STORAGE_DIR=./document_store
MAX_UPLOAD_BYTES=15728640
TEMP_UPLOAD_DIR=.pending_uploads